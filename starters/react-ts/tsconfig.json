{
  // TypeScript для React-стартера: строгая проверка своего кода (src/).
  // Кит написан на JS с JSDoc — его типы TypeScript берёт из комментариев.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client", "node"],
    "paths": {
      "kit/*": ["../../kit/*"],
      "@test/*": ["../../test/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../../kit/types/*.d.ts"]
}
