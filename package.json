{
  "name": "frontend-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Универсальный шаблон для фриланс-проектов: общее ядро (JS-модули, SCSS, React-хуки, dev-инструменты) + стартеры vanilla и React",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "create": "node scripts/create.mjs",
    "new": "node kit/cli/new.mjs --root starters/vanilla",
    "dev": "vite --config starters/vanilla/vite.config.js",
    "dev:react": "vite --config starters/react/vite.config.js",
    "build": "npm run build:vanilla && npm run build:react && npm run build:react-ts && npm run build:astro",
    "build:vanilla": "vite build --config starters/vanilla/vite.config.js",
    "build:react": "vite build --config starters/react/vite.config.js",
    "preview": "vite preview --config starters/vanilla/vite.config.js",
    "preview:react": "vite preview --config starters/react/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.scss\"",
    "fix": "eslint . --fix && stylelint \"**/*.scss\" --fix && prettier . --write --log-level warn",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc -p . && tsc -p starters/react-ts && astro check --root starters/astro",
    "dev:react-ts": "vite --config starters/react-ts/vite.config.ts",
    "build:react-ts": "vite build --config starters/react-ts/vite.config.ts",
    "dev:astro": "astro dev --root starters/astro",
    "build:astro": "astro build --root starters/astro"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "swiper": "^14.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "astro": "^7.3.5",
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "htmlparser2": "^12.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
